# ──────────────────────────────────────────────────────────────────────────────
# Placement Syndicate - Environment Variables Template
# Copy this to .env and fill in the values
# ──────────────────────────────────────────────────────────────────────────────

# MySQL Configuration
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=mini_user_service

# Mail Configuration (Notification Service)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# DevSecOps Secrets (Used in GitHub Actions)
DOCKER_USERNAME=your-docker-id
DOCKER_PASSWORD=your-docker-password
SONAR_TOKEN=your-sonar-token
SONAR_HOST_URL=http://localhost:9000

# Other Service Configuration
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-service:8100/eureka
